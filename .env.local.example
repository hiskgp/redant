# Meta WhatsApp Embedded Signup
# Browser-safe values for the Meta JS SDK and the Embedded Signup configuration.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# Server-side Meta App credentials.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Token used by Meta when verifying the /api/whatsapp/webhook callback.
# Set the same value in Meta App -> WhatsApp -> Configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-redant-webhook-verify-token

# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Instagram API with Instagram Login.
# If Instagram uses the same Meta App, these app ID/secret values may match
# META_APP_ID / META_APP_SECRET. Keep the Instagram callback URI exact in
# Meta App Dashboard -> Instagram Login -> Valid OAuth Redirect URIs.
INSTAGRAM_APP_ID=your-meta-app-id
INSTAGRAM_APP_SECRET=your-meta-app-secret
INSTAGRAM_REDIRECT_URI=https://your-domain.example/api/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-instagram-webhook-verify-token

# Safety switch: keep false until the Instagram webhook is subscribed and a
# real test comment produces exactly one permitted private reply.
INSTAGRAM_AUTOMATION_ENABLED=false

# Protects both Instagram maintenance endpoints:
# GET /api/instagram/refresh-tokens (daily token refresh)
# GET /api/instagram/recover-events (quarantine interrupted events; no resend)
# Set INSTAGRAM_CRON_SECRET and CRON_SECRET to the same strong random value.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>; x-cron-secret is
# also accepted for manual/other schedulers. Never expose this secret to clients.
# Generate with: openssl rand -hex 32
INSTAGRAM_CRON_SECRET=your-instagram-cron-secret
# Set this to the same value above in Vercel so its scheduled requests authenticate.
CRON_SECRET=your-instagram-cron-secret

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required — without it the webhook rejects every request.
#
# Several RedANT accounts connecting several WABAs under ONE Meta App
# need only that app's secret — this is the normal multi-WABA setup.
# If your WABAs live under DIFFERENT Meta Apps (each app signs with
# its own secret), list every app's secret separated by commas; a
# webhook is accepted when its signature matches any of them.
# Whitespace around the commas is ignored. See docs/multi-waba.md.
#   META_APP_SECRET=secret-of-app-one,secret-of-app-two
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is only needed when the request-derived
# origin would be wrong — e.g. from a cron job or background worker.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# UI language. Available catalogues (messages/*.json): en | ko | pt | es
# Unknown values fall back to en. Inlined at build time — rebuild after changing.
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for invite URL hostnames.
# ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations. Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID (Meta for Developers → App Settings → Basic). Required to
# create/edit message templates with an IMAGE header. Pair with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores a synthetic dry-run template. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# AI credentials are configured per account under Settings → AI Assistant.
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
